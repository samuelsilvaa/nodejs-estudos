datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id      Int    @id @default(autoincrement())
  nome    String
  email   String @unique
  senha   String
  tarefas Tarefa[]
  refreshTokens RefreshToken[]
}

model Tarefa {
  id        Int   @id @default(autoincrement())
  titulo    String
  concluido Boolean @default(false)
  criadaEm  DateTime @default(now())
  usuarioId Int 
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}


model RefreshToken {
  id          Int       @id @default(autoincrement())
  tokenHash   String    @unique    // SHA-256 do token (o token inteiro nunca é guardado)
  familia     String               // identifica a cadeia de tokens de um mesmo login
  usadoEm     DateTime?            // preenchido quando o token é usado (rotação)
  expiraEm  DateTime
  criadoEm    DateTime  @default(now())
  usuarioId   Int
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([familia])
}